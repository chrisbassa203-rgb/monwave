<!DOCTYPE html>

<html lang="fr">

<head>

<meta charset="UTF-8">

<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>MonWave - Paiement facile</title>

<style>

*{box-sizing:border-box}

body{margin:0;font-family:Arial,sans-serif;background:#f4f7fb;color:#17243b}

header{background:#1464f4;color:white;padding:25px 7%;display:flex;justify-content:space-between;align-items:center}

.logo{font-size:27px;font-weight:bold}

header span{font-size:13px}

main{max-width:900px;margin:35px auto;padding:0 20px}

.hero{background:white;padding:35px;border-radius:20px;text-align:center}

h1{font-size:32px;color:#1464f4}

.hero p{color:#66758a;line-height:1.6}

h2{font-size:22px;margin-top:35px}

.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:15px}

.card{background:white;padding:22px;border-radius:16px;box-shadow:0 4px 15px #00000008}

.card h3{margin-top:0}

button{background:#1464f4;color:white;border:0;padding:13px 20px;border-radius:10px;font-weight:bold;cursor:pointer}

select{padding:12px;border:1px solid #ddd;border-radius:9px;width:100%;margin:10px 0}

#pay{display:none;margin-top:20px;background:#edf3ff;padding:20px;border-radius:14px}

footer{text-align:center;padding:30px;color:#66758a;font-size:13px}

</style>

</head>

<body>

<header>

<div class="logo">MonWave</div>

<span>Paiement simple et rapide</span>

</header>

<main>

<section class="hero">

<h1>Bienvenue sur MonWave</h1>

<p>Payez vos achats et vos services en toute simplicité.</p>

<button onclick="document.getElementById('services').scrollIntoView({behavior:'smooth'})">Découvrir les services</button>

</section>

<h2 id="services">Nos services</h2>

<div class="grid">

<div class="card"><h3>🛍️ Achats en ligne</h3><p>Payez vos commandes auprès des boutiques.</p><button onclick="choisir('Achats en ligne')">Choisir</button></div>

<div class="card"><h3>💡 Factures</h3><p>Retrouvez vos paiements de factures.</p><button onclick="choisir('Factures')">Choisir</button></div>

<div class="card"><h3>📱 Recharges</h3><p>Rechargez votre téléphone et votre internet.</p><button onclick="choisir('Recharges')">Choisir</button></div>

<div class="card"><h3>🎫 Abonnements</h3><p>Payez vos abonnements et vos services.</p><button onclick="choisir('Abonnements')">Choisir</button></div>

</div>

<section id="pay" class="card">

<h2>Choisir un moyen de paiement</h2>

<p id="service"></p>

<select id="moyen">

<option>Wave</option>

<option>Orange Money</option>

<option>MTN Money</option>

</select>

<button onclick="demo()">Continuer</button>

<p id="message"></p>

</section>

</main>

<footer>MonWave © 2026 · Démonstration</footer>

<script>

function choisir(n){

document.getElementById('service').textContent='Service choisi : '+n;

document.getElementById('pay').style.display='block';

document.getElementById('pay').scrollIntoView({behavior:'smooth'});

}

function demo(){

document.getElementById('message').textContent='Démonstration : aucun paiement réel n’est effectué.';

}

</script>

</body>

</html>
